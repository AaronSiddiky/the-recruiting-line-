# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Settings -> API Keys -> "Publishable key". Safe in the browser: every query
# made with it runs under RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Settings -> API Keys -> "Secret key". Server only -- it bypasses RLS, which
# is how the Twilio webhooks write call rows with no user session. Never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key/Secret are used to mint browser softphone access tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The TwiML App whose Voice URL points at /api/twilio/softphone
TWILIO_TWIML_APP_SID=
# Caller IDs shown to prospects, comma-separated. Use at least as many
# numbers as lines per batch: each line dials from a different one, which
# avoids per-number outbound queueing and spreads volume so no single number
# absorbs all the spam-flagging risk.
TWILIO_CALLER_IDS=+1XXXXXXXXXX,+1XXXXXXXXXX,+1XXXXXXXXXX,+1XXXXXXXXXX

# Public origin Twilio can reach for webhooks. In dev this is your ngrok URL.
# No trailing slash.
APP_URL=http://localhost:3001
# Shared secret appended to webhook URLs as a second factor alongside Twilio
# signature validation. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI pipeline (Phase 4)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
