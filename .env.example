# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Settings -> API Keys -> "Publishable key". Safe in the browser: every query
# made with it runs under RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Settings -> API Keys -> "Secret key". Server only -- it bypasses RLS, which
# is how the Twilio webhooks write call rows with no user session. Never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key/Secret are used to mint browser softphone access tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The TwiML App whose Voice URL points at /api/twilio/softphone
TWILIO_TWIML_APP_SID=
# Every caller ID this Twilio account owns, comma-separated. Which rep dials
# from which one is decided by TWILIO_NUMBER_BY_REP below; this list is what
# the app may pick from, and the fallback for an unassigned rep.
TWILIO_CALLER_IDS=+1XXXXXXXXXX,+1XXXXXXXXXX
# One dedicated number per rep, by login email. A rep dials from the same
# number every time, so a prospect who has been called before recognises it and
# a callback reaches the person who dialled them.
TWILIO_NUMBER_BY_REP=a@example.com=+1XXXXXXXXXX;b@example.com=+1XXXXXXXXXX

# Public origin Twilio can reach for webhooks. In dev this is your ngrok URL.
# No trailing slash.
APP_URL=http://localhost:3000
# Shared secret appended to webhook URLs as a second factor alongside Twilio
# signature validation. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI pipeline (Phase 4)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Dialer
# ---------------------------------------------------------------------------
# Calls per rep per day the shared scoreboard treats as a full day.
DAILY_CALL_GOAL=50
# Twilio's account-wide concurrent-call cap (softphone legs included). A rep on
# a call uses two slots -- the prospect's leg and their own softphone leg -- so
# this has to be at least twice the number of reps dialing at once, or they
# queue behind each other. Measured at 4 for this account, which is exactly two
# reps, and 4 is also the floor in code: setting this lower has no effect, so a
# forgotten 3 cannot quietly bring the turn-taking back. Setting it higher does
# work -- Twilio lifts the limit once a Trust Hub Primary Customer Profile is
# approved, and a second account (TWILIO2_*) is the other way to add room.
TWILIO_CONCURRENT_CALLS=4

# ---------------------------------------------------------------------------
# Spotify (optional) -- the player dock on the dialer
# ---------------------------------------------------------------------------
# developer.spotify.com -> Dashboard -> Create app. Add these Redirect URIs:
#   https://www.therecruitingline.com/api/spotify/callback
#   http://127.0.0.1:3000/api/spotify/callback   (Spotify rejects "localhost"; browse the local dev site at 127.0.0.1 too)
# Only the Client ID is needed; sign-in uses PKCE. The app owner and each rep
# who connects need Spotify Premium: the Web API is Premium-only since 2025.
SPOTIFY_CLIENT_ID=
